+    UNSAFE_TODO({
+      const uint8_t back_alpha = pixel[3];
+      if (back_alpha == 0) {
+        pixel[0] = bgra.blue;
+        pixel[1] = bgra.green;
+        pixel[2] = bgra.red;
+        pixel[3] = static_cast<uint8_t>(src_alpha);
+      } else if (src_alpha != 0) {
+        const uint8_t dest_alpha = CalculateDestAlpha(back_alpha, src_alpha);
+        const int ratio = back_alpha == 255 ? src_alpha : src_alpha * 255 / dest_alpha;
+        pixel[0] = FXDIB_ALPHA_MERGE(pixel[0], bgra.blue, ratio);
+        pixel[1] = FXDIB_ALPHA_MERGE(pixel[1], bgra.green, ratio);
+        pixel[2] = FXDIB_ALPHA_MERGE(pixel[2], bgra.red, ratio);
+        pixel[3] = dest_alpha;
+      }
+    });
