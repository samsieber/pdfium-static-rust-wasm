+  const uint16x4_t shifted = vshrn_n_u32(accum, 16);
+  const uint8x8_t out = vmovn_u16(vcombine_u16(shifted, shifted));
+  return vget_lane_u32(vreinterpret_u32_u8(out), 0);
+}
