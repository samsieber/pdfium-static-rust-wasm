diff --git a/config/rust_wasm/BUILD.gn b/config/rust_wasm/BUILD.gn
new file mode 100644
index 0000000..9176308
--- /dev/null
+++ b/config/rust_wasm/BUILD.gn
@@ -0,0 +1,55 @@
+declare_args() {
+  rust_wasm_target = "wasm32-unknown-unknown"
+  rust_wasm_sysroot = ""
+  rust_wasm_sysroot_target = ""
+  rust_wasm_simd = false
+}
+
+config("compiler") {
+  include_dirs = [ "//build/config/rust_wasm/include" ]
+
+  defines = [
+    "_POSIX_C_SOURCE=200112",
+    "__wasi__",
+  ]
+
+  cflags = [
+    "--target=$rust_wasm_target",
+    "-nostdlib",
+    "-fvisibility=hidden",
+    "-Wno-unknown-warning-option",
+  ]
+
+  if (rust_wasm_simd) {
+    cflags += [ "-msimd128" ]
+  }
+
+  cflags_cc = [
+    "--target=$rust_wasm_target",
+    "-nostdlib",
+    "-fno-exceptions",
+    "-fno-rtti",
+    "-Wno-unknown-warning-option",
+  ]
+
+  ldflags = [
+    "--target=$rust_wasm_target",
+    "-nostdlib",
+  ]
+
+  if (rust_wasm_sysroot != "") {
+    cflags += [ "--sysroot=$rust_wasm_sysroot" ]
+    cflags_c = [
+      "-isystem",
+      "$rust_wasm_sysroot/include/$rust_wasm_sysroot_target",
+    ]
+    cflags_cc += [
+      "-nostdinc++",
+      "-isystem",
+      "$rust_wasm_sysroot/include/$rust_wasm_sysroot_target/c++/v1",
+      "-isystem",
+      "$rust_wasm_sysroot/include/$rust_wasm_sysroot_target",
+    ]
+    ldflags += [ "--sysroot=$rust_wasm_sysroot" ]
+  }
+}
