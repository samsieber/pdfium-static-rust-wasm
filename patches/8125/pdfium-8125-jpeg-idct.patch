 #include "jpeglib.h"
 #include "jdct.h"               /* Private declarations for DCT subsystem */
 
+#if defined(__wasm_simd128__) && BITS_IN_JSAMPLE == 8 && \
+    !defined(SHORTxSHORT_32) && !defined(SHORTxLCONST_32)
