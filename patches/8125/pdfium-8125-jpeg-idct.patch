   JLONG tmp10, tmp11, tmp12, tmp13;
   JLONG z1, z2, z3, z4, z5;
@@ -410,6 +544,7 @@ _jpeg_idct_islow(j_decompress_ptr cinfo, jpeg_component_info *compptr,
 
     wsptr += DCTSIZE;           /* advance pointer to next row */
   }
+#endif /* JPEG_WASM_ISLOW */
